  "item": [
    {
      "name": "Create Customer",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Customer created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('customerId', body.id);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Tien Nguyen\"\n}", "options": {"raw": {"language": "json"}}},
        "url": "{{baseUrl}}/api/customers"
      },
      "response": []
    },
    {
      "name": "Create Account",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Primary account created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('accountId', body.accountId);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"userId\": \"{{customerId}}\",\r\n  \"accountType\": \"SAVINGS\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/accounts"
      },
      "response": []
    },
    {
      "name": "Get Account",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}"
      },
      "response": []
    },
    {
      "name": "Deposit Money",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"amount\": 500\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit"
      },
      "response": []
    },
    {
      "name": "Withdraw Money",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"amount\": 200\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw"
      },
      "response": []
    },
    {
      "name": "Transaction History",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/transactions"
      },
      "response": []
    },
    {
      "name": "Create Destination Account",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Destination account created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('destinationAccountId', pm.response.json().accountId);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"userId\": \"{{customerId}}\",\n  \"accountType\": \"CHECKING\"\n}", "options": {"raw": {"language": "json"}}},
        "url": "{{baseUrl}}/api/accounts"
      },
      "response": []
    },
    {
      "name": "Get Accounts For Customer",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Customer has multiple accounts', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.at.least(2); });"
      ]}}],
      "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts?userId={{customerId}}"},
      "response": []
    },
    {
      "name": "Get Premium Accounts",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Premium results meet threshold', () => { pm.response.to.have.status(200); pm.response.json().forEach(a => pm.expect(a.balance).to.be.at.least(100)); });"
      ]}}],
      "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/accounts/premium?threshold=100"},
      "response": []
    },
    {
      "name": "Transfer Money",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Transfer succeeded', () => pm.response.to.have.status(200));",
        "pm.test('Both account states returned', () => { const b = pm.response.json(); pm.expect(b.fromAccount).to.exist; pm.expect(b.toAccount).to.exist; });"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": 100\n}", "options": {"raw": {"language": "json"}}},
        "url": "{{baseUrl}}/api/accounts/transfer"
      },
      "response": []
    },
    {
      "name": "Reject Same Account Transfer",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Unsafe transfer rejected', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{accountId}}\",\n  \"amount\": 50\n}", "options": {"raw": {"language": "json"}}},
        "url": "{{baseUrl}}/api/accounts/transfer"
      },
      "response": []
    },
    {
      "name": "Get All Audits",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Audit records returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });",
        "pm.test('Rejected operation was audited', () => pm.expect(pm.response.json().some(a => a.status === 'REJECTED')).to.be.true);"
      ]}}],
      "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/audits"},
      "response": []
    },
    {
      "name": "Get Account Audits",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Account audit trail returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });"
      ]}}],
      "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/audits/account/{{accountId}}"},
      "response": []
    },
    {
      "name": "Delete Primary Account",
      "request": {"method": "DELETE", "header": [], "url": "{{baseUrl}}/api/accounts/{{accountId}}"},
      "response": []
    },
    {
      "name": "Delete Destination Account",
      "request": {"method": "DELETE", "header": [], "url": "{{baseUrl}}/api/accounts/{{destinationAccountId}}"},
      "response": []
    },
    {
      "name": "Delete Customer",
      "request": {"method": "DELETE", "header": [], "url": "{{baseUrl}}/api/customers/{{customerId}}"},
      "response": []
    }
  ],
