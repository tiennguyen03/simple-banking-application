            "exec": [
              "pm.test(\"Expected status 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/audits"
