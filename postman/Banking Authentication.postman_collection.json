          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/admin"
      }
    },
    {
      "name": "Customer Audit Access Forbidden",
      "event": [
        {
